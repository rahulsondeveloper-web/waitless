# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:4200"]

# PostgreSQL 18
DB_HOST=localhost
DB_PORT=5432
# Database owner: used only by migrations and setup scripts
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=CHANGE_ME
# App runtime role (non-owner, created by migration 0002; Row-Level Security applies). Pick a random password.
DB_USER=waitless_app
DB_PASSWORD=CHANGE_ME_RANDOM
DB_NAME=waitless
DB_NAME_TEST=waitless_test

# Memurai / Redis. Leave empty to run without Redis (single process only).
REDIS_URL=redis://127.0.0.1:6379/0

# Auth: random string, at least 32 characters (required in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Local file storage (decision D26)
STORAGE_BACKEND=local
MEDIA_URL=/media
MAX_UPLOAD_MB=5

# Restaurant registrations per client IP per hour (raise in development for repeated e2e runs)
REGISTER_LIMIT_PER_HOUR=10
