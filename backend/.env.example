# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:4200"]

# PostgreSQL 18
DB_HOST=localhost
DB_PORT=5432
# Database owner: used only by migrations and setup scripts
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=CHANGE_ME
# App runtime role (non-owner, created by migration 0002; Row-Level Security applies). Pick a random password.
DB_USER=waitless_app
DB_PASSWORD=CHANGE_ME_RANDOM
DB_NAME=waitless
DB_NAME_TEST=waitless_test

# Memurai / Redis. Leave empty to run without Redis (single process only).
REDIS_URL=redis://127.0.0.1:6379/0

# Auth: random string, at least 32 characters (required in production)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Local file storage (decision D26)
STORAGE_BACKEND=local
MEDIA_URL=/media
MAX_UPLOAD_MB=5

# Restaurant registrations per client IP per hour (raise in development for repeated e2e runs)
REGISTER_LIMIT_PER_HOUR=10
# Contact-form messages per client IP per hour
CONTACT_LIMIT_PER_HOUR=5
# Password sign-in attempts per client IP per 15 minutes
LOGIN_IP_LIMIT_PER_15MIN=30

# Payments (decision D57): "mock" for development, "cashfree" for real money
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
# Cashfree dashboard -> Developers -> API Keys. CASHFREE_ENV=sandbox uses test keys and test money.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Sent to Cashfree when the payer has no phone on file (Cashfree requires one)
CASHFREE_FALLBACK_PHONE=9999999999
# Minutes a paid booking waits for its payment before it expires
PAYMENT_HOLD_MINUTES=15

# ---- Phase 12: production integrations (development defaults shown) ----
# Files: local | s3 (AWS S3, MinIO or Cloudflare R2 via S3_ENDPOINT_URL)
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT_URL=
# S3_PUBLIC_BASE_URL=
# Maps / address search: nominatim | google
MAPS_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=
# Messaging: console logs only. sms: msg91 | twilio · whatsapp: twilio | meta · email: smtp
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console
# MSG91_AUTH_KEY= / MSG91_OTP_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_SMS_FROM= / TWILIO_WHATSAPP_FROM=
# META_WHATSAPP_TOKEN= / META_WHATSAPP_PHONE_ID=
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASSWORD= / SMTP_FROM=
PUBLIC_BASE_URL=http://localhost:4200
# Prometheus scrape token for /api/v1/metrics (empty = endpoint off)
METRICS_TOKEN=
# Production template with every setting: infra/env/production.env.example
