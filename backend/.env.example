# Copy to backend/.env and fill in. Never commit .env.

ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:4200"]

# PostgreSQL 18 (database created in pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=waitless
DB_NAME_TEST=waitless_test

# Memurai / Redis. Leave empty to run without Redis (single process only).
REDIS_URL=redis://127.0.0.1:6379/0

# Local file storage (decision D26). Path is relative to backend/ when not absolute.
STORAGE_BACKEND=local
MEDIA_URL=/media
MAX_UPLOAD_MB=5
