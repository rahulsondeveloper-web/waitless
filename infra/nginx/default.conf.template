# WaitLess — single origin for the SPA, REST API, Socket.IO and media (Phase 12).
# Rendered at container start by infra/nginx/entrypoint.sh (${DOMAIN}, ${SSL_CERT}, ${SSL_KEY}).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream waitless_api {
  ip_hash;              # Socket.IO: a browser stays on one API replica (rooms are shared via Redis)
  server api:8000 max_fails=3 fail_timeout=10s;
  keepalive 32;
}

# Abuse protection in front of the app's own per-account limits.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

server {
  listen 80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     ${SSL_CERT};
  ssl_certificate_key ${SSL_KEY};
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  client_max_body_size 6m;   # MAX_UPLOAD_MB + overhead
  server_tokens off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  root /usr/share/nginx/html;
  index index.html;
  include /etc/nginx/snippets/security-headers.conf;

  # Internal only: Prometheus scrapes the API replicas directly on the Docker network.
  location = /api/v1/metrics { return 404; }

  location /api/v1/auth/ {
    limit_req zone=auth burst=20 nodelay;
    proxy_pass http://waitless_api;
    include /etc/nginx/snippets/proxy-params.conf;
  }

  location /api/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://waitless_api;
    include /etc/nginx/snippets/proxy-params.conf;
  }

  location /socket.io/ {
    proxy_pass http://waitless_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }

  location /media/ {
    proxy_pass http://waitless_api;
    include /etc/nginx/snippets/proxy-params.conf;
    expires 30d;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
  }

  # Hashed bundles can be cached forever; index.html must never be cached.
  location ~* \.(?:js|css|woff2?|svg|png|jpg|webp|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-store";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
