# WaitLess production settings. Copy to infra/env/production.env (never commit it) and replace every CHANGE_ME.
# The API refuses to start in production with development defaults (see app/core/config.py).

# ---- site ----
DOMAIN=app.CHANGE_ME.in
ACME_EMAIL=ops@CHANGE_ME.in
PUBLIC_BASE_URL=https://app.CHANGE_ME.in
CORS_ORIGINS=["https://app.CHANGE_ME.in"]
WAITLESS_VERSION=1.0.0
API_REPLICAS=2
LOG_LEVEL=INFO

# ---- database (owner for migrations; the app uses DB_USER, a non-owner role created by migration 0002) ----
DB_NAME=waitless
DB_MIGRATION_USER=waitless_owner
DB_MIGRATION_PASSWORD=CHANGE_ME_long_random
DB_USER=waitless_app
DB_PASSWORD=CHANGE_ME_long_random
DB_POOL_SIZE=10

# ---- auth: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))" ----
JWT_SECRET=CHANGE_ME_at_least_32_random_characters

# ---- payments (Cashfree) ----
PAYMENT_PROVIDER=cashfree
CASHFREE_APP_ID=CHANGE_ME
CASHFREE_SECRET_KEY=CHANGE_ME      # also verifies webhook signatures
CASHFREE_ENV=production
# Cashfree dashboard → Developers → Webhooks → https://DOMAIN/api/v1/webhooks/payments/cashfree
# (orders also carry this notify_url automatically when PUBLIC_BASE_URL is https)

# ---- files: S3 (or MinIO / Cloudflare R2 with S3_ENDPOINT_URL) ----
STORAGE_BACKEND=s3
S3_BUCKET=waitless-media-CHANGE_ME
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=https://media.CHANGE_ME.in   # CloudFront in front of the bucket
MEDIA_HOST=https://media.CHANGE_ME.in           # allowed image host in the Content-Security-Policy
AWS_ACCESS_KEY_ID=CHANGE_ME                     # or leave empty and use an IAM instance role
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ---- maps: nominatim (free, rate limited) or google ----
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=CHANGE_ME

# ---- messaging ----
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=CHANGE_ME
MSG91_OTP_TEMPLATE_ID=CHANGE_ME   # DLT-approved OTP template with ##OTP##
WHATSAPP_PROVIDER=meta
META_WHATSAPP_TOKEN=CHANGE_ME
META_WHATSAPP_PHONE_ID=CHANGE_ME
EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=WaitLess <no-reply@CHANGE_ME.in>

# ---- operations ----
METRICS_TOKEN=CHANGE_ME_random   # Prometheus scrapes /api/v1/metrics with "Authorization: Bearer <token>"
BACKUP_KEEP_DAYS=14
BACKUP_AT=02:30
BACKUP_S3_URI=s3://waitless-backups-CHANGE_ME/prod
